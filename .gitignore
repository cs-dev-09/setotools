# Python bytecode (Blender generates these next to the source when an addon loads)
__pycache__/
*.py[cod]

# Built addon zips - published as GitHub Release assets, not tracked here
*.zip

# Where scripts/build_extension.py stages the extension package before it is
# uploaded. The listing it also writes, docs/repo/index.json, IS tracked: that
# one is served from GitHub Pages and is how Blender finds the release.
dist/

# Built documentation - GitHub Actions builds and publishes it, see
# .github/workflows/docs.yml. The source is docs/.
site/

# Blender
*.blend1
*.blend2

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Working notes for the AI sessions that build this - local only, never published
.claude/
